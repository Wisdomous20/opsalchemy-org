# Server-only OpenAI credentials. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-proj-replace-with-project-key
OPENAI_VECTOR_STORE_ID=vs_replace_with_vector_store_id
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_REALTIME_MODEL=gpt-realtime

# Supabase PostgreSQL connections. DATABASE_URL is the pooled runtime URL;
# DIRECT_URL is the direct/session URL used only by Prisma CLI migrations.
# Keep both server-only and require TLS.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Optional Google Calendar scheduling for one personal Google account. Keep all
# OAuth values server-only. Request calendar.events and calendar.freebusy with
# offline access so the server can create events and check conflicts.
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=replace-with-offline-refresh-token
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_EVENT_TITLE=OPSAlchemy Consultation
